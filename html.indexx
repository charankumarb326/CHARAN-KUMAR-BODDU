<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pressroom Pro | Offset Operator Tools</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .card { @apply bg-gray-800 p-6 rounded-xl border border-gray-700 shadow-xl; }
        input { @apply w-full bg-gray-900 border border-gray-600 p-3 rounded mt-1 text-white focus:border-blue-500 outline-none; }
        label { @apply text-xs font-bold text-blue-400 uppercase tracking-wider; }
    </style>
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen pb-10">

    <nav class="bg-black p-4 sticky top-0 z-50 border-b border-blue-900">
        <div class="max-w-4xl mx-auto flex justify-between items-center">
            <h1 class="text-xl font-black tracking-tighter">PRESSROOM <span class="text-blue-500">PRO</span></h1>
            <span class="text-[10px] bg-blue-900 px-2 py-1 rounded">V2.0 LIVE</span>
        </div>
    </nav>

    <div class="max-w-4xl mx-auto p-4 space-y-6">

        <div class="card">
            <h2 class="text-lg font-bold mb-4 text-white">⏱️ JOB RUN-TIME</h2>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label>Impressions Left</label>
                    <input id="totalImp" type="number" placeholder="50000">
                </div>
                <div>
                    <label>Speed (IPH)</label>
                    <input id="speed" type="number" placeholder="12000">
                </div>
            </div>
            <button onclick="calcRun()" class="w-full mt-4 bg-blue-600 py-3 rounded font-bold hover:bg-blue-500 transition">CALCULATE FINISH</button>
            <div id="runResult" class="mt-4 text-center hidden">
                <p class="text-3xl font-mono text-green-400" id="runOutput"></p>
            </div>
        </div>

        <div class="card border-l-4 border-yellow-500">
            <h2 class="text-lg font-bold mb-4 text-white">📏 PACKING & SQUEEZE</h2>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label>Cylinder Undercut</label>
                    <input id="undercut" type="number" step="0.01" placeholder="0.50mm">
                </div>
                <div>
                    <label>Blanket + Packing</label>
                    <input id="blanket" type="number" step="0.01" placeholder="0.55mm">
                </div>
            </div>
            <button onclick="calcSqueeze()" class="w-full mt-4 bg-yellow-600 py-3 rounded font-bold hover:bg-yellow-500 transition text-black">CALCULATE SQUEEZE</button>
            <div id="squeezeResult" class="mt-4 text-center hidden">
                <p class="text-2xl font-mono" id="squeezeOutput"></p>
            </div>
        </div>

        <div class="card">
            <h2 class="text-lg font-bold mb-4 text-white">⚖️ PAPER WEIGHT CONVERTER</h2>
            <div class="space-y-4">
                <div>
                    <label>GSM (Grams per Square Meter)</label>
                    <input id="gsmIn" type="number" oninput="convertGsm(this.value)" placeholder="e.g. 150">
                </div>
                <div class="p-4 bg-gray-900 rounded border border-dashed border-gray-600 text-center">
                    <p class="text-sm text-gray-400">Equivalent to approx:</p>
                    <p class="text-xl font-bold text-blue-400" id="basisOutput">-- lbs</p>
                </div>
            </div>
        </div>

    </div>

    <script>
        function calcRun() {
            const imp = document.getElementById('totalImp').value;
            const speed = document.getElementById('speed').value;
            if (imp && speed) {
                const hours = Math.floor(imp / speed);
                const mins = Math.round(((imp / speed) - hours) * 60);
                document.getElementById('runOutput').innerText = hours + "h " + mins + "m";
                document.getElementById('runResult').classList.remove('hidden');
            }
        }

        function calcSqueeze() {
            const u = parseFloat(document.getElementById('undercut').value);
            const b = parseFloat(document.getElementById('blanket').value);
            if (u && b) {
                const squeeze = (b - u).toFixed(2);
                document.getElementById('squeezeOutput').innerText = squeeze + "mm Squeeze";
                document.getElementById('squeezeResult').classList.remove('hidden');
            }
        }

        function convertGsm(gsm) {
            // Rough conversion factor for Text paper (GSM * 0.675)
            const lbs = (gsm * 0.675).toFixed(1);
            document.getElementById('basisOutput').innerText = gsm > 0 ? lbs + " lbs (Text)" : "-- lbs";
        }
    </script>
</body>
</html>
